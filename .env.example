# Copy this file to .env and fill in real (test-mode) values before running
# docker compose up, or the local venv workflow described in README.md.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional: buyer_agent.py falls back to a deterministic heuristic planner
# (no live LLM) if this is absent or the API call fails.
GROQ_API_KEY=

# Optional overrides
# GROQ_MODEL=groq/compound-mini
# MERCHANT_BASE_URL=http://127.0.0.1:8000
